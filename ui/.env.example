# ─────────────────────────────────────────────────────────────────────────
# FormPing UI — environment variables
#
# Copy to `.env.local` for local development, or set these in the Railway
# service "Variables" tab for production. `.env.local` is gitignored — never
# commit real secrets.
#
# AUTH IS OPTIONAL: if NONE of the auth vars are set, the app runs with an OPEN
# gate (no login required) — handy for local dev. The gate turns ON automatically
# as soon as Google auth (or the legacy password auth) is configured.
# ─────────────────────────────────────────────────────────────────────────

# ── Storage: Supabase (Postgres) ─────────────────────────────────────────
# When BOTH are set, FormPing stores everything in Supabase. When unset, it
# falls back to JSON files on disk — so the app runs either way.
#
# Get these from your Supabase project → Settings → API Keys:
#   SUPABASE_URL              → "Project URL" (https://<ref>.supabase.co)
#   SUPABASE_SERVICE_ROLE_KEY → a SECRET key (sb_secret_… / service_role JWT)
#
# The secret key bypasses Row Level Security, so it is SERVER-ONLY: it has no
# NEXT_PUBLIC_ prefix and must never be committed or exposed to the browser.
# Run the migrations in supabase/migrations/ before first use.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Which Postgres SCHEMA to use. Optional — defaults to `public`.
#
# Prod and development share one Supabase project but are isolated by schema, so
# they never share a table (working agreement rule 6, "Production data is sacred"):
#
#   public → PRODUCTION   — Railway leaves this UNSET
#   dev    → development  — set SUPABASE_SCHEMA=dev in your local .env.local
#
# Keep this set to `dev` locally: our test/smoke scripts insert and delete rows,
# and this is what stops them ever reaching a live client's data.
# SUPABASE_SCHEMA=dev

# ── Slack notifications (optional, free) ─────────────────────────────────
# Set this to a Slack Incoming Webhook to get a message in your channel when
# a monitor detects a change or a failure — Change Monitor (watch + one-off
# compare runs), Form Watch, and Site Watch all use this same webhook.
# Create one at: https://api.slack.com/messaging/webhooks
# Leave empty to disable: runs still execute and are stored, the Slack send is
# simply skipped (best-effort — a Slack outage never breaks a run).
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Optional SEPARATE channel for the footer "Report a bug" form. Create a second
# Incoming Webhook pointed at your bug-reports channel and set it here. If unset,
# bug reports fall back to SLACK_WEBHOOK_URL above. (Reports are also stored in
# the `bug_reports` table regardless.)
# BUG_REPORT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# How often (in HOURS) to RE-NOTIFY while a problem is still unresolved — a site
# that stays down, or an SSL certificate / domain registration that stays
# expired. The first alert fires on change as usual; after that a spaced reminder
# repeats on this interval until it recovers, so an ongoing outage doesn't go
# silent. Optional — defaults to 6. Recovery still alerts exactly once.
# ALERT_RENOTIFY_HOURS=6

# ── Slack @mentions on alerts (optional) ─────────────────────────────────
# Lets an alert @mention the person who set the broken monitor up, instead of
# landing in the channel addressed to nobody. Optional — without it alerts post
# exactly as they do today, unmentioned.
#
# Needs a Slack app with a BOT token (free on every plan), scopes:
#   users:read + users:read.email  — turn the owner's email into a user id
#   channels:read, groups:read     — read channel membership, so we don't
#                                    @mention someone who isn't in the channel
#                                    (public and private channels respectively)
# Invite the bot to the alerts channel, or the membership check can't see it.
# SLACK_BOT_TOKEN=xoxb-...
#
# The channel to check membership against. Optional: unset means "skip the
# check and mention anyway" — a missing value must not silently switch
# mentioning off. Find it in Slack: channel name -> View channel details.
# SLACK_ALERT_CHANNEL_ID=C0123456789
#
# Resolved ids are cached on app_users.slack_user_id, so there is no per-user
# setup and a cached id keeps working if the token is later revoked.

# ── Per-user isolation of the tool tabs ──────────────────────────────────
# When ON, the four tool tabs (Form Tester, Form Scheduler, Uptime & SSL,
# Content Changes) show only the signed-in user's own work. Projects stays
# shared either way — it is what stops two people monitoring the same URL.
#
# Optional, and OFF unless set to one of: 1 / on / true / yes. Off is the
# current behaviour (everyone sees everything), so leaving it unset changes
# nothing. Anything unrecognised also reads as off, deliberately: a typo must
# not silently hide people's own work from them.
#
# Rows created before this feature have no owner and stay visible to everyone
# until re-run — there is no way to say after the fact who made them.
# FEATURE_PER_USER_ISOLATION=on

# ── Google OAuth (primary sign-in) ───────────────────────────────────────
# Create an OAuth 2.0 "Web application" client at:
#   https://console.cloud.google.com/apis/credentials
# Add this Authorized redirect URI to that client:
#   https://YOUR-DOMAIN/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback   (for local testing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. The exact callback URL registered above. If omitted, it is derived
# from the incoming request origin (honors x-forwarded-* behind Railway's
# proxy). Set it explicitly in production if you hit redirect-URI mismatches.
# GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/api/auth/google/callback

# Comma-separated list of email domains allowed to sign in. Defaults to
# "apexure.com" if unset. Anyone outside these domains is rejected after Google
# verifies them. Add client domains here without touching code.
ALLOWED_AUTH_DOMAINS=apexure.com

# ── Access privileges (FR-24) — roles: owner / admin / member / viewer ────
# The app assigns each signed-in email a role (stored in the `app_users` table).
# New allow-listed logins default to Member.
#
# OWNER_EMAIL — the break-glass owner. Whoever this is becomes Owner IF the table
# has no owner (first boot / recovery). Once an owner exists, the table is the
# source of truth (so an ownership transfer sticks). This guarantees the app can
# never end up with no administrator. Set it to the person who runs the app.
# OWNER_EMAIL=you@apexure.com
#
# ADMIN_EMAILS — optional, comma-separated. These emails start as Admin on their
# FIRST login (a convenience seed for known admins; roles are managed in-app after).
# ADMIN_EMAILS=manager@apexure.com,pm@apexure.com

# REQUIRED when using Google auth: a long random string used to sign the
# session cookie (there is no password to derive it from in Google-only mode).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=

# Optional. Session lifetime in days (default 7).
# AUTH_SESSION_DAYS=7

# ── Legacy username/password auth (optional, kept for backward compat) ────
# Not needed when using Google auth. If set, the password gate also activates.
# AUTH_USER=
# AUTH_PASSWORD=
