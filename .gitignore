# Dependencies
node_modules/

# Build output
dist/
.next/
# The e2e suite's own build dir — kept separate so running the suite and a dev
# server at the same time cannot race over one .next (see ui/next.config.mjs).
.next-e2e/
out/
build/
*.tsbuildinfo

# Test / cache
.cache/
coverage/

# Playwright (E2E) — generated artifacts, never committed
test-results/
playwright-report/
playwright/.cache/

# Monitor runtime data (user-specific snapshots)
data/

# Environment — DENY-ALL, then allow back only the placeholder template.
# Safer than listing variants: an unlisted name (.env.production, .env.local.bak,
# .env.staging) was previously committable. Everything is ignored by default now;
# `.env.example` is the single deliberate exception and must hold no real values.
.env*
*.env
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Backups
*.tar.gz
*.zip
*.bak

# Internal planning / process docs — kept local, never pushed to GitHub
docs/architecture/
WORKING_AGREEMENT.md
AUDIT.md
